# 复制本文件为 .env，填上你自己的密钥。.env 已被 .gitignore 排除，不会提交。
#
# 这些值只在**首次启动**时写进数据库（密钥用 Fernet 加密），
# 之后以「模型供应商」页面里的配置为准。

# ---- 对话模型（任何 OpenAI 兼容服务）----
DEV_LLM_BASE_URL=https://your-gateway/v1
DEV_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
DEV_LLM_MODEL=your-chat-model

# ---- 向量模型（必须支持 POST /embeddings）----
DEV_EMBED_BASE_URL=https://your-gateway/v1
DEV_EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx
DEV_EMBED_MODEL=your-embedding-model

# ---- 重排模型（可选：不填就按 RRF 融合分排序）----
# 阿里 DashScope 的 base_url 通常是 .../compatible-mode/v1，但 rerank 走域名根，
# 代码会自动取 origin，直接照抄控制台给的地址即可。
DEV_RERANK_BASE_URL=
DEV_RERANK_API_KEY=
DEV_RERANK_MODEL=

# ---- 应用 ----
# 留空用默认：127.0.0.1 / 8000 / <仓库根>/data / INFO
APP_HOST=
APP_PORT=
APP_DATA_DIR=
APP_LOG_LEVEL=

# 外网代理。留空 = 直连（本机默认）；需要走代理才填，例如 http://127.0.0.1:7890
# 注意：Windows 注册表里的系统代理本项目**不会**读，避免被坏代理拖死。
APP_HTTP_PROXY=